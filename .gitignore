# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Data files (large)
*.parquet
*.hdf5
# Generic HDF5 excluded, but model weight files are tracked so the
# deployment server can run inference without retraining.
*.h5
!*.weights.h5

# Generated numpy caches (rebuilt automatically, do not commit)
numpy_cache/

# Large corpus directories (regenerated by run_pipeline.py)
training_data/
validation_data/

# Environment
.env
*.env.local

# OS
.DS_Store
Thumbs.db

# Large raw data files (not committed — copy manually to server)
reference_material/*.csv
reference_material/*.zip

# Corpus manifest (points to local parquet files that aren't in the repo)
corpus_manifest.json

# Build / run logs
*.log
pipeline_*.log
training*.log
corpus_generation*.log
add_btc_negatives.log
# crash.log is the exception — it is tracked so server crashes are visible on GitHub
!crash.log

# Claude internal config
.claude/
